<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.AspNetCore.OpenApi (nativo de .NET 9) es incompatible en runtime con
         Microsoft.OpenApi 2.x que trae Swashbuckle.AspNetCore >= 7, así que se usa
         únicamente Swashbuckle para generar el documento OpenAPI y servir Swagger UI. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <!-- PostgreSQL/EF Core (M2.2-S01): primera infraestructura de base de datos
         relacional real del proyecto, en paralelo a los registries de archivos JSON
         existentes bajo App_Data/ (que esta tarjeta no toca). -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Identidad propia (M3.1-S02, ADR docs/ADR_AUTH_MVP31.md, decisión confirmada: ASP.NET Core Identity + cookie).
         UserManager/SignInManager/AddIdentityCookies ya vienen en el shared framework Microsoft.AspNetCore.App; este
         paquete añade SOLO el almacén EF (IdentityDbContext, UserStore) para el AuthDbContext (esquema "auth"). Misma
         línea 10.0.13 que EF Core, que es lo que resuelve el resto del proyecto. -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <!-- Solo para el tooling de diseño (dotnet ef migrations add / database update),
         nunca se necesita en runtime: PrivateAssets evita que se propague como
         dependencia a proyectos que referencien este. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
