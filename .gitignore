# Node / frontend
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*

# .NET / backend
bin/
obj/
*.user
backend/Vectorify.Api/App_Data/
backend/.publish-check/

# Python / services
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/

# Entornos y secretos (nunca versionar valores reales)
.env
.env.*
!.env.example
!frontend/.env.example
!services/python-engine/.env.example
# Claves y certificados (M3.1-S09): el key ring de Data Protection (cifra la cookie de sesión), claves TLS/PEM y almacenes PKCS#12 jamás se versionan.
*.pem
*.key
*.pfx
*.p12
dataprotection-keys/
.pgpass

# Editores / SO
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Node.js portable usado localmente (activar-node.ps1)
node-v*-win-x64/

# Scratch de agentes (copias temporales para correr suites en Docker, etc.)
.test-worktrees/

# Respaldos locales generados por scripts/backup.* (nunca versionar datos)
backups/
